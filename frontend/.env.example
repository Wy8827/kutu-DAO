# Deployed NEAR Testnet contract account ID.
VITE_CONTRACT_ID=kutunear.testnet

# Optional: private Testnet RPC endpoint used only by the local Vite dev-server proxy.
# Leave blank to use the public Testnet RPC fallback. Do not prefix with VITE_.
NEAR_RPC_URL=

# Optional Supabase chat configuration. Public client key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
